# Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/fluxpay?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_IDLE_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_SECRET=your-super-secret-access-key-change-me
JWT_REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=fluxpay-notifications

# Features
ADMIN_ENABLED=true
